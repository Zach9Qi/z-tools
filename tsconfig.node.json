{
  // Node 侧(vite / vitest 配置与 scripts/ 发布脚本)类型检查配置,由根 tsconfig.json 的 references 引用,`vue-tsc -b` 统一执行。
  // -b 模式会写 tsbuildinfo 做增量,放进 node_modules 以免污染工作区。
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "noEmit": true
  },
  "include": ["vite.config.ts", "vitest.config.ts", "scripts/**/*.ts"]
}
